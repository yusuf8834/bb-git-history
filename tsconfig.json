{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "server.ts",
    "server.test.ts",
    "host.ts",
    "host.test.ts",
    "contracts.ts",
    "repository-error.ts",
    "graph.ts",
    "graph.test.ts",
    "app.tsx",
    "app.test.tsx",
    "sdk-boundary.test.ts",
    "frontend-sdk-boundary.test.ts",
    "components",
    "lib",
    "hooks"
  ]
}
